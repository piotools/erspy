enum KThreadState {
    INITIALIZED,
    READY,
    RUNNING,
    STANDBY,
    TERMINATED,
    WAITING,
    TRANSITION,
    DEFERRED_READY,
    GATE_WAIT_OBSOLETE,
    WAITING_FOR_PROCESS_IN_SWAP,
    MAXIMUM_THREAD_STATE
}

enum KWaitReason {
    EXECUTIVE,
    FREE_PAGE,
    PAGE_IN,
    POOL_ALLOCATION,
    DELAY_EXECUTION,
    SUSPENDED,
    USER_REQUEST,
    WR_EXECUTIVE,
    WR_FREE_PAGE,
    WR_PAGE_IN,
    WR_POOL_ALLOCATION,
    WR_DELAY_EXECUTION,
    WR_SUSPENDED,
    WR_USER_REQUEST,
    WR_EVENT_PAIR,
    WR_QUEUE,
    WR_LPC_RECEIVE,
    WR_LPC_REPLY,
    WR_VIRTUAL_MEMORY,
    WR_PAGE_OUT,
    WR_RENDEZVOUS,
    WR_KEYED_EVENT,
    WR_TERMINATED,
    WR_PROCESS_IN_SWAP,
    WR_CPU_RATE_CONTROL,
    WR_CALLOUT_STACK,
    WR_KERNEL,
    WR_RESOURCE,
    WR_PUSH_LOCK,
    WR_MUTEX,
    WR_QUANTUM_END,
    WR_DISPATCH_INT,
    WR_PREEMPTED,
    WR_YIELD_EXECUTION,
    WR_FAST_MUTEX,
    WR_GUARDED_MUTEX,
    WR_RUNDOWN,
    WR_ALERT_BY_THREAD_ID,
    WR_DEFERRED_PREEMPT,
    WR_PHYSICAL_FAULT,
    WR_IO_RING,
    WR_MDL_CACHE,
    WR_RCU,
    MAXIMUM_WAIT_REASON
}
