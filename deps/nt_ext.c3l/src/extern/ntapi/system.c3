module ntapi @if (env::WIN32);

// functions

extern fn int query_system_info(
    SystemInformationClass system_information_class,
    void* system_information,
    uint system_information_length,
    uint* return_length
) @cname("NtQuerySystemInformation");

// structs

struct SystemProcessInformation {
    uint next_entry_offset;
    uint number_of_threads;
    ulong working_set_private_size;
    uint hard_fault_count;
    uint number_of_threads_high_watermark;
    ulong cycle_time;
    LargeInteger create_time;
    LargeInteger user_time;
    LargeInteger kernel_time;
    UnicodeString image_name;
    int base_priority;
    void* unique_process_id;
    void* inherited_from_unique_process_id;
    uint handle_count;
    uint session_id;
    ulong unique_process_key;
    usz peak_virtual_size;
    usz virtual_size;
    uint page_fault_count;
    usz peak_working_set_size;
    usz working_set_size;
    usz quota_peak_paged_pool_usage;
    usz quota_paged_pool_usage;
    usz quota_peak_non_paged_pool_usage;
    usz quota_non_paged_pool_usage;
    usz pagefile_usage;
    usz peak_pagefile_usage;
    usz private_page_count;
    LargeInteger read_operation_count;
    LargeInteger write_operation_count;
    LargeInteger other_operation_count;
    LargeInteger read_transfer_count;
    LargeInteger write_transfer_count;
    LargeInteger other_transfer_count;
    SystemThreadInformation[1] threads;
}

struct SystemHandleTableEntryInfo {
    ushort unique_process_id;
    ushort creator_back_trace_index;
    char object_type_index;
    char handle_attributes;
    ushort handle_value;
    void* object;
    uint granted_access;
}

struct SystemHandleInformation {
    uint number_of_handles;
    SystemHandleTableEntryInfo[1] handles;
}

struct SystemThreadInformation {
    LargeInteger kernel_time;
    LargeInteger user_time;
    LargeInteger create_time;
    uint wait_time;
    void* start_address;
    ClientId client_id;
    int priority;
    int base_priority;
    uint context_switches;
    KThreadState thread_state;
    KWaitReason wait_reason;
}

